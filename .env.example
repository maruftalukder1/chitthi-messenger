# চিঠি · Chitthi — environment variables
#
# This file documents every environment variable the code actually reads
# (verified by grepping `process.env` in server.ts, src/, and vite.config.ts,
# plus the two Phase-0 demo flags defined in PHASE0_REPORT.md).
# Copy the entries you need into a local `.env` / `.env.local` file.
# Placeholders only — never put a real secret in this file or commit one.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port server.ts listens on. Default: 3000.
# Hosts such as Azure App Service assign this automatically.
PORT=3000

# Set to "production" for a production run: server.ts then serves the built
# dist/ folder instead of the Vite development server.
# Any other value (or unset) means development mode.
# Production also hard-disables both demo flags below.
NODE_ENV=development

# Directory where the server writes its disk snapshot (store.json, holding
# room messages and channels). Default: ./data next to server.ts.
# Point this at a persistent folder outside the deployment directory on
# hosts where redeploys would otherwise wipe chat history.
CHITTHI_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Email verification (SMTP)
#
# All three of SMTP_HOST, SMTP_USER and SMTP_PASS must be set for real
# email delivery. If any of them is missing, the server falls back to a
# test/demo transport and verification email is not really delivered.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-placeholder
# SMTP port. Default: 587. Port 465 is treated as secure (TLS).
SMTP_PORT=587

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Set to "true" to disable Vite HMR and file watching
# (read by vite.config.ts). Development environments only.
DISABLE_HMR=false

# ---------------------------------------------------------------------------
# DEMO FLAGS — demo / local development only, NEVER set in production
#
# Both flags are ignored / hard-disabled when NODE_ENV=production.
# ---------------------------------------------------------------------------

# DEMO ONLY — never set in production.
# When "true" (and NODE_ENV is not "production"), the email-verification
# endpoint POST /api/auth/send-2fa-code may include the verification code
# in its API response, so a local demo can complete verification without
# a working mailbox. Leave unset / "false" anywhere real.
CHITTHI_DEMO_OTP=false

# DEMO ONLY — never set in production.
# When "true" (and NODE_ENV is not "production"), WebSocket and REST
# callers may authenticate with a self-asserted user ID (or an
# X-Demo-User header) instead of a verified Firebase ID token.
# Leave unset / "false" anywhere real.
CHITTHI_ALLOW_UNAUTH_DEMO=false

# ---------------------------------------------------------------------------
# Client (Vite build-time, .env.local)
# ---------------------------------------------------------------------------

# GIF picker provider: "klipy" or "giphy". Both need an API key the project
# owner creates with the provider. Leave BOTH unset and the GIF picker shows
# a "not configured" empty state (no fake feed is ever shown).
VITE_GIF_PROVIDER=
# API key for the provider above (build-time, public by design — restrict it
# by referrer/domain in the provider dashboard).
VITE_GIF_API_KEY=
